generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id               String         @id @default(uuid())
  email            String         @unique
  passwordHash     String?
  googleId         String?        @unique
  facebookId       String?        @unique
  name             String
  firstName        String?
  lastName         String?
  phone            String?
  role             Role           @default(CITIZEN)
  emailVerified    Boolean        @default(false)
  emailVerifiedAt  DateTime?
  totpSecretEnc    String?
  totpEnabled      Boolean        @default(false)
  failedLoginCount Int            @default(0)
  lockedUntil      DateTime?
  lastLoginAt      DateTime?
  lastLoginIp      String?
  createdAt        DateTime       @default(now())
  reports          Report[]
  votes            Vote[]
  comments         Comment[]
  notifications    Notification[]
  auditLogs        AuditLog[]
  departments      Department[]   @relation("DepartmentStaff")
  refreshTokens    RefreshToken[]
  authTokens       AuthToken[]
  trustedDevices   TrustedDevice[]
}

model RefreshToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model AuthToken {
  id        String        @id @default(uuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      AuthTokenType
  tokenHash String        @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime      @default(now())

  @@index([userId, type])
}

enum AuthTokenType {
  EMAIL_VERIFY
  PASSWORD_RESET
  TWO_FACTOR
}

/// "Trust this device" — lets a user skip the TOTP challenge on a device they
/// recognize for a limited time. Only a hash of the device token is stored;
/// it's revoked wholesale whenever 2FA is disabled or the password changes.
model TrustedDevice {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  expiresAt  DateTime
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?

  @@index([userId])
}

/// Facebook (or other) OAuth that did not share an email. No User row until
/// the person confirms an email; the raw token is never stored.
model OauthPending {
  id         String   @id @default(uuid())
  tokenHash  String   @unique
  provider   String
  providerId String
  name       String
  email      String?
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  @@index([provider, providerId])
}

enum Role {
  CITIZEN
  DEPARTMENT_STAFF
  DEPARTMENT_ADMIN
  SUPER_ADMIN
}

/// How Prizren Smart City exchanges incident data with an external organization.
/// Defaults to MANUAL until an adapter/credentials are configured (Phase 7/8).
enum IntegrationType {
  EMAIL
  REST_API
  WEBHOOK
  SFTP
  MANUAL
  MOCK
}

/// Lifecycle of an organization's integration — starts NOT_CONFIGURED, can be
/// exercised via MOCK/TEST before going ACTIVE. Never implies a real connection
/// exists until explicitly wired up in Phase 7/8.
enum IntegrationStatus {
  NOT_CONFIGURED
  MOCK
  TEST
  ACTIVE
  DISABLED
}

/// External organization ("Organization" in the Master Spec) — a municipal
/// institution or utility that incidents can be routed/assigned to. Kept as
/// `Institution` (not renamed) for backward compatibility with existing code.
model Institution {
  id                String            @id @default(uuid())
  name              String
  slug              String            @unique
  type              String
  /// Public call-center / switchboard. Never store an email here.
  phone             String?
  /// Email mailbox only. Null until a public address is verified on an official page.
  contact           String?
  /// Public social/messaging contact (e.g. Facebook Page URL or Messenger link) for institutions
  /// without a public email. Never used by the automated outbound-mail sender — informational only,
  /// for staff to use when initiating manual contact.
  socialContact     String?
  active            Boolean           @default(true)
  integrationType   IntegrationType   @default(MANUAL)
  integrationStatus IntegrationStatus @default(NOT_CONFIGURED)
  createdAt         DateTime          @default(now())
  departments       Department[]
  reports           Report[]
  routingRules      RoutingRule[]
  outboundEmails    OutboundEmail[]
  accessTokens      InstitutionAccessToken[]
}

model Department {
  id            String        @id @default(uuid())
  name          String
  contact       String?
  slaHours      Int           @default(48)
  institutionId String?
  institution   Institution?  @relation(fields: [institutionId], references: [id])
  categories    Category[]
  reports       Report[]
  staff         User[]        @relation("DepartmentStaff")
  routingRules  RoutingRule[]
  slaPolicies   SlaPolicy[]
}

model Category {
  id              String         @id @default(uuid())
  name            String
  departmentId    String
  department      Department     @relation(fields: [departmentId], references: [id])
  slaHours        Int            @default(48)
  defaultPriority Priority       @default(MEDIUM)
  reports         Report[]
  routingRules    RoutingRule[]
  slaPolicies     SlaPolicy[]
  subcategories   Subcategory[]
}

/// First-class subcategory under a Category. Routing rules and reports may
/// reference `subcategoryId`; the legacy free-text `subcategory` string on
/// RoutingRule/Report is kept in sync with `name` when an id is set.
model Subcategory {
  id           String        @id @default(uuid())
  name         String
  categoryId   String
  category     Category      @relation(fields: [categoryId], references: [id])
  active       Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  reports      Report[]
  routingRules RoutingRule[]
  slaPolicies  SlaPolicy[]

  @@unique([categoryId, name])
  @@index([categoryId])
  @@index([active])
}

/// Geographic / administrative zone for routing match. Empty seed by design —
/// admins configure real zones; null zoneId on a rule is a wildcard.
model Zone {
  id           String        @id @default(uuid())
  name         String        @unique
  active       Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  reports      Report[]
  routingRules RoutingRule[]

  @@index([active])
}

/// Deterministic routing rule ("category/subcategory/severity/zone/emergency
/// status" -> department/organization), evaluated in `priority` order (lower
/// number = evaluated first). Introduced as a domain model in Phase 1; the
/// evaluation engine itself is wired up in Phase 3 — see RoutingService.
/// Null fields act as wildcards (match any value) except `active`.
model RoutingRule {
  id              String        @id @default(uuid())
  name            String
  categoryId      String?
  category        Category?     @relation(fields: [categoryId], references: [id])
  /// Legacy / denormalized name — kept for match fallback and admin display.
  subcategory     String?
  subcategoryId   String?
  subcategoryRef  Subcategory?  @relation(fields: [subcategoryId], references: [id])
  severity        Priority?
  /// Legacy free-text zone label; prefer zoneId. Synced from Zone.name when set.
  zone            String?
  zoneId          String?
  zoneRef         Zone?         @relation(fields: [zoneId], references: [id])
  /// null = matches emergency or non-emergency; true/false = must match exactly
  isEmergency     Boolean?
  departmentId    String?
  department      Department?   @relation(fields: [departmentId], references: [id])
  institutionId   String?
  institution     Institution?  @relation(fields: [institutionId], references: [id])
  /// Lower value = higher precedence when multiple rules match.
  priority        Int           @default(100)
  /// Optional overrides — when null, routing falls back to category then department.
  slaHours        Int?
  defaultPriority Priority?
  active          Boolean       @default(true)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([active, priority])
  @@index([categoryId])
  @@index([subcategoryId])
  @@index([zoneId])
  @@index([departmentId])
  @@index([institutionId])
}

/// SLA policy — response/resolution windows per priority, optionally scoped to
/// department / category / subcategory. Null scope fields = broader fallback.
/// Precedence (most specific wins): subcategory → category → department → global.
/// Wired into approve-time deadline snapshots — see reports/sla-resolve.ts.
model SlaPolicy {
  id             String       @id @default(uuid())
  name           String
  priority       Priority
  /// Minutes until first response is due.
  responseTime   Int
  /// Minutes until resolution is due.
  resolutionTime Int
  departmentId   String?
  department     Department?  @relation(fields: [departmentId], references: [id])
  categoryId     String?
  category       Category?    @relation(fields: [categoryId], references: [id])
  subcategoryId  String?
  subcategory    Subcategory? @relation(fields: [subcategoryId], references: [id])
  active         Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  reports        Report[]

  @@index([active, priority])
  @@index([departmentId])
  @@index([categoryId])
  @@index([subcategoryId])
}

/// Generic atomic counter table — used today for per-year public incident IDs
/// (`report-<year>` -> sequence value). Kept generic so other sequences
/// (e.g. per-organization external batch numbers) can reuse it later.
model SequenceCounter {
  id    String @id
  value Int    @default(0)
}

model Report {
  id               String          @id @default(uuid())
  /// Human-readable incident code, e.g. "PRZ-2026-000184". Generated atomically
  /// on creation via SequenceCounter; immutable afterwards.
  publicId         String          @unique
  userId           String
  user             User            @relation(fields: [userId], references: [id])
  categoryId       String?
  category         Category?       @relation(fields: [categoryId], references: [id])
  /// Legacy free-text label; prefer subcategoryId when set.
  subcategory      String?
  subcategoryId    String?
  subcategoryRef   Subcategory?    @relation(fields: [subcategoryId], references: [id])
  /// Optional administrative zone for zone-scoped routing rules.
  zoneId           String?
  zoneRef          Zone?           @relation(fields: [zoneId], references: [id])
  departmentId     String?
  department       Department?     @relation(fields: [departmentId], references: [id])
  /// Responsible external organization, when routing selects one (distinct
  /// from `departmentId`, which is always an internal municipal department).
  institutionId    String?
  institution      Institution?    @relation(fields: [institutionId], references: [id])
  description      String
  status           ReportStatus    @default(SUBMITTED)
  priority         Priority?
  lat              Float
  lng              Float
  /// PostGIS point — kept in sync from lat/lng (raw SQL)
  location         Unsupported("geography(Point,4326)")?
  address          String?
  photoUrl         String?
  photoAfterUrl    String?
  aiClassification Json?
  aiConfidence     Float?
  duplicateOfId    String?
  duplicateOf      Report?         @relation("ReportDuplicates", fields: [duplicateOfId], references: [id])
  duplicates       Report[]        @relation("ReportDuplicates")
  /// True once this report has been linked to a master/duplicate report.
  isDuplicate      Boolean         @default(false)
  assignedStaffId  String?
  /// Submission channel — WEB today; kept open for future MOBILE/KIOSK/API sources.
  source           String          @default("WEB")
  /// True when the report was submitted without exposing citizen identity downstream.
  anonymous        Boolean         @default(false)
  /// BCP-47-ish language tag of the citizen-entered text, e.g. "sq", "en".
  language         String          @default("sq")
  dueAt            DateTime?
  /// Policy used when deadlines were snapshotted (approve/queue entry). Null = no SLA applied yet.
  slaPolicyId      String?
  slaPolicy        SlaPolicy?      @relation(fields: [slaPolicyId], references: [id])
  /// First-response deadline at snapshot time (UTC). Immutable once set.
  responseDueAt    DateTime?
  /// Resolution deadline at snapshot time (UTC). Immutable once set; mirrored to dueAt for queue UX.
  resolutionDueAt  DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  statusHistory    StatusHistory[]
  votes            Vote[]
  comments         Comment[]
  outboundEmails   OutboundEmail[]
  accessTokens     InstitutionAccessToken[]
  media            ReportMedia[]

  @@index([status])
  @@index([categoryId])
  @@index([subcategoryId])
  @@index([zoneId])
  @@index([departmentId])
  @@index([institutionId])
  @@index([userId])
  @@index([createdAt])
  @@index([dueAt])
  @@index([slaPolicyId])
  @@index([responseDueAt])
  @@index([resolutionDueAt])
}

enum ReportStatus {
  SUBMITTED
  RECEIVED
  UNDER_REVIEW
  ASSIGNED
  IN_PROGRESS
  WAITING_FOR_INFORMATION
  RESOLVED
  REJECTED
  DUPLICATE
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model StatusHistory {
  id        String       @id @default(uuid())
  reportId  String
  report    Report       @relation(fields: [reportId], references: [id])
  oldStatus ReportStatus
  newStatus ReportStatus
  changedBy String
  note      String?
  changedAt DateTime     @default(now())
}

model Vote {
  id       String @id @default(uuid())
  reportId String
  userId   String
  report   Report @relation(fields: [reportId], references: [id])
  user     User   @relation(fields: [userId], references: [id])

  @@unique([reportId, userId])
}

model Comment {
  id        String   @id @default(uuid())
  reportId  String
  userId    String
  text      String
  createdAt DateTime @default(now())
  report    Report   @relation(fields: [reportId], references: [id])
  user      User     @relation(fields: [userId], references: [id])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  reportId  String?
  type      String
  channel   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

enum OutboundEmailStatus {
  NOT_CONFIGURED
  QUEUED
  SENDING
  SENT
  ACCEPTED
  FAILED
  RETRYING
  PERMANENTLY_FAILED
}

enum OutboundEmailPurpose {
  INSTITUTION_NEW_CASE
}

/// Institutional outbound mail ledger. Citizen mail does not use this table.
/// Send is off unless INSTITUTIONAL_MAIL_ENABLED=true and institution policy allows it.
model OutboundEmail {
  id                String               @id @default(uuid())
  reportId          String
  report            Report               @relation(fields: [reportId], references: [id])
  institutionId     String?
  institution       Institution?         @relation(fields: [institutionId], references: [id])
  purpose           OutboundEmailPurpose
  recipient         String?
  subject           String
  provider          String?
  providerMessageId String?
  status            OutboundEmailStatus
  skipReason        String?
  attemptCount      Int                  @default(0)
  maxAttempts       Int                  @default(3)
  lastError         String?
  queuedAt          DateTime             @default(now())
  sentAt            DateTime?
  acceptedAt        DateTime?
  failedAt          DateTime?
  nextRetryAt       DateTime?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  accessTokenId     String?
  accessToken       InstitutionAccessToken? @relation(fields: [accessTokenId], references: [id])

  @@unique([reportId, purpose])
  @@index([status])
  @@index([institutionId])
  @@index([nextRetryAt])
}

enum InstitutionAccessPurpose {
  INSTITUTION_NEW_CASE
  INSTITUTION_CASE_PDF
}

/// Hashed, expiring, revocable link for institutional mail. Raw token is never stored.
/// Opening the link still requires staff login and membership in the bound institution.
model InstitutionAccessToken {
  id             String                    @id @default(uuid())
  tokenHash      String                    @unique
  reportId       String
  report         Report                    @relation(fields: [reportId], references: [id])
  institutionId  String
  institution    Institution               @relation(fields: [institutionId], references: [id])
  purpose        InstitutionAccessPurpose
  expiresAt      DateTime
  revokedAt      DateTime?
  lastUsedAt     DateTime?
  createdAt      DateTime                  @default(now())
  outboundEmails OutboundEmail[]

  @@index([reportId, purpose])
  @@index([institutionId])
  @@index([expiresAt])
}

enum ReportMediaRole {
  INITIAL
  AFTER
  ATTACHMENT
}

enum ReportMediaVisibility {
  PUBLIC
  STAFF
}

/// Scalable photos/attachments. Report.photoUrl / photoAfterUrl stay the denormalized primary.
model ReportMedia {
  id           String                @id @default(uuid())
  reportId     String
  report       Report                @relation(fields: [reportId], references: [id], onDelete: Cascade)
  role         ReportMediaRole
  sortOrder    Int                   @default(0)
  url          String
  cloudinaryId String?
  mimeType     String?
  byteSize     Int?
  visibility   ReportMediaVisibility @default(PUBLIC)
  createdAt    DateTime              @default(now())

  @@index([reportId, role, sortOrder])
}

/// Immutable audit trail for administrative/state-changing actions across the
/// platform. `entityType`/`entityId` generalize the Master Spec's `incidentId`
/// to any entity (Report, User, Institution, RoutingRule, ...).
model AuditLog {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  /// e.g. "USER", "SYSTEM", "EXTERNAL" — defaults to USER for existing call sites.
  actorType  String   @default("USER")
  action     String
  entityType String
  entityId   String
  oldValue   Json?
  newValue   Json?
  metadata   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([userId])
  @@index([createdAt])
}
