# Database (Docker postgres / PostGIS)
DATABASE_URL=postgresql://prizren:prizren@localhost:5432/prizren_smart_city?schema=public

# API
PORT=3001
CORS_ORIGIN=http://localhost:3000

# Auth
JWT_ACCESS_SECRET=change-me-access
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_DAYS=7
REFRESH_COOKIE_NAME=refresh_token

# Cloudinary (Phase 3+)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=prizren-reports

# Claude (Phase 5+)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
# Confidence below this marks needs_review (UNDER_REVIEW), no auto-accept
# AI_CONFIDENCE_THRESHOLD=0.6

# Redis (optional — docker compose --profile redis up)
# REDIS_URL=redis://localhost:6379

# Sentry (Phase 11 — free tier; leave empty to disable)
# SENTRY_DSN=
# SENTRY_TRACES_SAMPLE_RATE=0.1

# Google OAuth (Phase 12.5 — leave empty until Cloud Console client is created)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_CALLBACK_URL=http://localhost:3001/auth/google/callback
# WEB_ORIGIN=http://localhost:3000

# Facebook Login
# FACEBOOK_APP_ID=
# FACEBOOK_APP_SECRET=
# FACEBOOK_CALLBACK_URL=http://localhost:3001/auth/facebook/callback

# Email (Resend — production provider, https://resend.com). Keys stay on the API.
# Never expose them to Next.js. If empty, verification/reset/report mail is logged.
# RESEND_API_KEY=
# MAIL_FROM=onboarding@resend.dev
# MAIL_FROM_NAME=Prizren Smart City

# Institutional outbound mail (default OFF). Citizen mail is unrelated.
# Even when true, send only if Institution.contact is set AND integrationType=EMAIL
# AND integrationStatus is TEST or ACTIVE. Do not invent mailboxes in seed.
# INSTITUTIONAL_MAIL_ENABLED=false
# INSTITUTION_ACCESS_TTL_DAYS=30

# Email (SMTP fallback, used only if RESEND_API_KEY is empty)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=

# 2FA
# AUTH_ENCRYPTION_KEY=
# REQUIRE_ADMIN_2FA=false
# JWT_REMEMBER_EXPIRES_DAYS=30
