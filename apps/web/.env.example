# Email is sent only by the API (apps/api MailService). Never put
# RESEND_API_KEY, SMTP_*, or MAIL_FROM in this file — those are server secrets.

# Next.js (apps/web)
NEXT_PUBLIC_API_URL=http://localhost:3001
# Public site URL for sitemap / Open Graph (production)
# NEXT_PUBLIC_SITE_URL=https://your-domain.example

# Mapbox (Phase 4+)
NEXT_PUBLIC_MAPBOX_TOKEN=

# Sentry (Phase 11 — free tier; leave empty to disable)
# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1

# Google OAuth button (must match API GOOGLE_* when ready)
# NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false
